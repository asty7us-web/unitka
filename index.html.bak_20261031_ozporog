const prerender=()=>{   // пока выбирают — соседние сервисы уже открываются в фоне (Chrome), переход мгновенный
  if(pre)return;pre=true;
  try{if(!(HTMLScriptElement.supports&&HTMLScriptElement.supports('speculationrules')))return;
    const s=document.createElement('script');s.type='speculationrules';
    s.textContent=JSON.stringify({prerender:[{source:'list',urls:[...m.querySelectorAll('a.svc-it:not([aria-current])')].map(a=>a.href),eagerness:'immediate'}]});
