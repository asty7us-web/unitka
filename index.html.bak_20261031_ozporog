.seg button:disabled{opacity:.45;cursor:default}
/* подсказки «Показать фишки» */
.tour-dim{position:fixed;inset:0;z-index:90}
.tour-spot{position:fixed;z-index:91;border-radius:12px;box-shadow:0 0 0 3px var(--accent),0 0 0 9999px rgba(10,10,10,.58);transition:top .22s ease,left .22s ease,width .22s ease,height .22s ease;pointer-events:none}
.tour-tip{position:fixed;z-index:92;width:min(350px,calc(100vw - 24px));background:var(--surface);color:var(--ink);border-radius:16px;box-shadow:0 16px 48px rgba(0,0,0,.38);padding:16px 16px 14px;transition:top .22s ease,left .22s ease}
.tour-tip .tn{font-size:12px;font-weight:700;color:var(--accent);text-transform:uppercase;letter-spacing:.04em;margin-bottom:4px}
.tour-tip h4{margin:0 0 6px;font-size:17px;line-height:1.25;padding-right:22px}
.tour-tip p{margin:0;color:var(--ink-2);font-size:14.5px;line-height:1.45}
.tour-tip .tf{display:flex;align-items:center;gap:8px;margin-top:14px;flex-wrap:wrap}
.tour-tip .dots{display:flex;gap:5px;margin-right:auto}
.tour-tip .dots i{width:7px;height:7px;border-radius:50%;background:var(--line)} .tour-tip .dots i.on{background:var(--accent);width:18px;border-radius:4px}
.tour-x{position:absolute;top:10px;right:10px;border:0;background:none;font-size:18px;line-height:1;color:var(--muted);padding:4px}
.newdot{width:8px;height:8px;border-radius:50%;background:var(--accent);box-shadow:0 0 0 0 var(--accent);animation:pulse 1.8s infinite}
@keyframes pulse{0%{box-shadow:0 0 0 0 rgba(42,120,214,.55)}70%{box-shadow:0 0 0 8px rgba(42,120,214,0)}100%{box-shadow:0 0 0 0 rgba(42,120,214,0)}}
.more{border:0;background:none;color:var(--accent);font-weight:600;padding:12px 14px;text-align:left;width:100%}
.tot{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;padding:12px 14px;border-bottom:1px solid var(--line)}
.tot div{font-size:12.5px;color:var(--ink-2)} .tot b{display:block;font-size:17px;color:var(--ink);font-variant-numeric:tabular-nums}
.detail{padding:16px;display:flex;flex-direction:column;gap:14px;position:sticky;top:calc(var(--hdr,57px) + 15px);max-height:calc(100vh - var(--hdr,57px) - 31px);overflow:auto}
.detail .title{font-size:18px;font-weight:700;overflow-wrap:anywhere}
.back{display:none} .backbar .bt{display:none}
.lock{max-width:440px;margin:24px auto;padding:20px;display:flex;flex-direction:column;gap:12px}
.lock input{height:44px;border-radius:11px;border:1px solid var(--ring);background:var(--surface-2);padding:0 12px;font-size:16px}
.empty{padding:28px 16px;text-align:center;color:var(--ink-2)}
.delta{font-size:12.5px;font-weight:600}

/* ── мои расчёты ── */
.saved{display:flex;flex-direction:column;gap:10px}
.toolbar{display:flex;gap:8px;flex-wrap:wrap;align-items:center;padding:12px}
.sv{display:grid;grid-template-columns:auto 1fr auto;gap:4px 12px;align-items:center;padding:12px 14px}
.sv .n{font-weight:650;overflow-wrap:anywhere}
.sv .s{color:var(--ink-2);font-size:13px}
.sv .acts{display:flex;gap:6px;grid-column:2/4;flex-wrap:wrap}
.toast{position:fixed;left:50%;bottom:calc(24px + var(--nav-h) + env(safe-area-inset-bottom));transform:translateX(-50%);background:var(--ink);color:var(--bg);padding:10px 16px;border-radius:12px;font-weight:600;z-index:50;opacity:0;transition:opacity .2s;pointer-events:none;max-width:90vw;text-align:center}
.toast.on{opacity:1}
.modal{position:fixed;inset:0;z-index:85;background:rgba(10,10,10,.45);display:flex;align-items:center;justify-content:center;padding:16px}
.modal .sheet{width:min(460px,100%);padding:16px;display:flex;flex-direction:column;gap:12px}
.modal .sheet .h{align-items:center}
.shurl{width:100%;height:42px;border-radius:10px;border:1px solid var(--ring);background:var(--surface-2);padding:0 10px;font-size:14px;color:var(--ink-2)}
a.btn{text-decoration:none;color:inherit}
@media (max-width:860px){.modal{align-items:flex-end;padding:0}.modal .sheet{border-radius:16px 16px 0 0;padding-bottom:calc(16px + env(safe-area-inset-bottom))}}
/* ── расширение: полоска в «Сводке» и окно «Как поставить» ── */
.extbar{display:flex;align-items:center;gap:10px;flex-wrap:wrap;margin-top:10px;padding:10px 12px;border-radius:12px;background:var(--accent-wash);color:var(--ink)}
.extbar>span{flex:1 1 220px;font-size:13px;line-height:1.35}
.extbar svg{width:22px;height:22px;flex:none;color:var(--accent)}
.modal .sheet.xg{width:min(780px,100%);max-height:min(92vh,980px);overflow:auto;overscroll-behavior:contain}
.xg ol{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:12px;counter-reset:xg}
.xg li{display:grid;grid-template-columns:minmax(0,1fr) 300px;gap:14px;align-items:center;padding:12px;border:1px solid var(--line);border-radius:12px;counter-increment:xg}
.xg h5{margin:0 0 5px;font-size:15.5px;line-height:1.3;display:flex;gap:9px;align-items:center}
.xg h5::before{content:counter(xg);width:26px;height:26px;border-radius:50%;background:var(--accent);color:#fff;display:grid;place-items:center;font-size:14px;flex:none}
.xg p{margin:0 0 6px;font-size:14px;line-height:1.45;color:var(--ink-2)} .xg p:last-child{margin-bottom:0}
.xg p b{color:var(--ink)}
.xg li>svg{width:100%;height:auto;display:block;border-radius:10px}
.xg .addr{display:flex;align-items:center;gap:8px;flex-wrap:wrap;margin:6px 0}
.xg code{font:600 15px/1 ui-monospace,Consolas,monospace;background:var(--surface-2);border:1px solid var(--ring);border-radius:8px;padding:9px 10px;user-select:all}
.xg [data-xi]{display:none}
.xg[data-xb="chrome"] [data-xi~="chrome"],.xg[data-xb="yandex"] [data-xi~="yandex"],.xg[data-xb="opera"] [data-xi~="opera"]{display:revert}
.xs-win{fill:var(--surface);stroke:var(--line)} .xs-bar{fill:var(--surface-2)} .xs-ln{stroke:var(--line);fill:none}
.xs-t{fill:var(--ink);font:600 11.5px var(--font)} .xs-m{fill:var(--muted);font:500 10.5px var(--font)} .xs-b{fill:var(--ink);font:700 12px var(--font)}
.xs-blue{fill:#2a78d6} .xs-wash{fill:var(--accent-wash)} .xs-w{fill:#fff;font:700 11px var(--font)}
.xs-hl{fill:none;stroke:#e5484d;stroke-width:2.5;animation:xs-blink 1.6s ease-in-out infinite}
@keyframes xs-blink{50%{opacity:.35}}
@media (prefers-reduced-motion: reduce){.xs-hl{animation:none}}
@media (max-width:860px){.xg li{grid-template-columns:minmax(0,1fr)}.xg li>svg{max-width:420px}}

/* ── телефон ── */
@media (max-width: 860px){
  :root{--nav-h:62px}
  .bar{padding:8px 16px;gap:8px}
  nav.tabs + #bTour{margin-left:auto}
  #bTheme span{display:none}
  .tl-full{display:none} .tl-short{display:inline}
  .brand span{display:inline}
  nav.tabs{position:fixed;left:0;right:0;bottom:0;z-index:30;background:var(--surface);border-top:1px solid var(--line);margin:0;
    padding:4px 8px calc(4px + env(safe-area-inset-bottom));justify-content:space-around;gap:0}
  nav.tabs button{flex-direction:column;gap:2px;font-size:11.5px;padding:6px 8px;min-width:76px}
  nav.tabs button[aria-current="page"]{background:transparent}
  main{padding:12px 12px 16px}
  .grid,.sum-grid{grid-template-columns:minmax(0,1fr)}
  .res,.detail{position:static;max-height:none;overflow:visible}
  .inp{width:132px}
  .lhead,.item{grid-template-columns:minmax(0,1fr) 60px 60px 60px;gap:6px;padding-left:12px;padding-right:12px}
  .mini{display:flex;position:fixed;left:8px;right:8px;bottom:calc(var(--nav-h) + 6px + env(safe-area-inset-bottom));z-index:25;
    background:var(--ink);color:var(--bg);border-radius:14px;padding:9px 14px;align-items:center;justify-content:space-between;gap:10px;border:0;font-weight:600;box-shadow:0 6px 20px rgba(0,0,0,.25)}
  .mini b{font-size:17px}
  .mini .g{opacity:.75;font-weight:500;font-size:13px}
  body.calc-on{padding-bottom:calc(var(--nav-h) + 64px + env(safe-area-inset-bottom))}
  .sumtot{grid-template-columns:repeat(4,1fr);gap:4px 8px;width:100%;padding:8px 12px}
  .sumtot b{font-size:16px} .sumtot div{font-size:11.5px}
  body.calc-on .toast{bottom:calc(var(--nav-h) + 74px + env(safe-area-inset-bottom))}
  .detail-wrap.open{position:fixed;top:var(--hdr,53px);left:0;right:0;bottom:0;z-index:40;background:var(--bg);overflow:auto;overscroll-behavior:contain;padding:0 0 calc(24px + var(--nav-h) + env(safe-area-inset-bottom))}
  .detail-wrap.open .backbar{position:sticky;top:0;z-index:3;background:var(--surface);margin:-16px -16px 0;padding:10px 16px;border-bottom:1px solid var(--line);display:flex;align-items:center;gap:10px;box-shadow:0 2px 8px rgba(0,0,0,.06)}
  .detail-wrap.open .backbar .bt{display:block;font-weight:700;font-size:15px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;min-width:0}
  .detail-wrap.open{animation:slidein .22s ease-out}
  @keyframes slidein{from{transform:translateX(40px);opacity:0}to{transform:none;opacity:1}}
  .detail-wrap.open .detail{border-radius:0;border:0;min-height:100%}
  .detail-wrap:not(.open){display:none}
  .back{display:inline-flex}
}
