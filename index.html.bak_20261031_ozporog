  paper:'<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"><path d="M4 5.5C6.5 4.3 9.2 4.4 12 6c2.8-1.6 5.5-1.7 8-.5V19c-2.5-1.2-5.2-1.1-8 .5-2.8-1.6-5.5-1.7-8-.5Z"/><path d="M12 6v13.5"/></svg>',
  aurora:'<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M3 15c3-6 6-8 9-4s6 2 9-4"/><path d="M3 19c3-4 6-5 9-2s6 1 9-3" opacity=".6"/><path d="M17 3.5v2.4M15.8 4.7h2.4"/></svg>',
  space:'<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><circle cx="12" cy="12" r="5.2"/><path d="M6.6 14.4C3.4 16.6 2 18.6 2.7 19.6c1.1 1.6 6.4-.6 11.7-4.9s8.6-9.1 7.5-10.6c-.7-1-3.1-.4-6.1 1.4"/><path d="M19 2.5v2.6M17.7 3.8h2.6" stroke-width="1.5"/></svg>'};
const SW={auto:'<svg class="sw" viewBox="0 0 20 20"><circle cx="10" cy="10" r="8.6" fill="#fcfcfb"/><path d="M10 1.4a8.6 8.6 0 0 1 0 17.2Z" fill="#1a1a19"/><circle cx="10" cy="10" r="8.6" fill="none" stroke="#8a8a85" stroke-width="1.2"/></svg>',
  light:'<svg class="sw" viewBox="0 0 20 20"><circle cx="10" cy="10" r="8.6" fill="#fcfcfb" stroke="#8a8a85" stroke-width="1.2"/></svg>',
  dark:'<svg class="sw" viewBox="0 0 20 20"><circle cx="10" cy="10" r="8.6" fill="#1a1a19" stroke="#8a8a85" stroke-width="1.2"/></svg>',
  farcry:'<svg class="sw" viewBox="0 0 20 20"><circle cx="10" cy="10" r="8.6" fill="#2a1d12" stroke="#c8241d" stroke-width="1.6"/><path d="M10 4.6a4.2 4.2 0 0 0-4.2 4.2c0 1.4.7 2.6 1.8 3.2v1.6h1v1.2h2.8V14h1v-1.6c1.1-.6 1.8-1.8 1.8-3.2A4.2 4.2 0 0 0 10 4.6Z" fill="#efe2c0"/><circle cx="8.4" cy="9.2" r=".9" fill="#2a1d12"/><circle cx="11.6" cy="9.2" r=".9" fill="#2a1d12"/></svg>',
  jim:'<svg class="sw" viewBox="0 0 20 20"><defs><linearGradient id="swJim" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#3a1263"/><stop offset=".62" stop-color="#d9532c"/><stop offset=".62" stop-color="#7ad321"/></linearGradient></defs><circle cx="10" cy="10" r="8.4" fill="url(#swJim)" stroke="#1a1022" stroke-width="1.6"/><circle cx="8.3" cy="7.6" r="2" fill="#fff" stroke="#1a1022" stroke-width=".8"/><circle cx="11.9" cy="7.6" r="2" fill="#fff" stroke="#1a1022" stroke-width=".8"/><circle cx="8.7" cy="7.8" r=".7" fill="#1a1022"/><circle cx="12.3" cy="7.8" r=".7" fill="#1a1022"/></svg>',
  sonic:'<svg class="sw" viewBox="0 0 20 20"><defs><linearGradient id="swSon" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#0f6efa"/><stop offset=".66" stop-color="#5fb0ff"/><stop offset=".66" stop-color="#3fbf1c"/><stop offset=".76" stop-color="#3fbf1c"/><stop offset=".76" stop-color="#cf6b16"/></linearGradient></defs><circle cx="10" cy="10" r="8.4" fill="url(#swSon)" stroke="#0a1a4a" stroke-width="1.6"/><circle cx="10" cy="8" r="3.4" fill="none" stroke="#ffc81e" stroke-width="1.9"/></svg>',
  solitaire:'<svg class="sw" viewBox="0 0 20 20"><circle cx="10" cy="10" r="8.6" fill="#0b2e1e" stroke="#e8c260" stroke-width="1.4"/><rect x="6.2" y="4.6" width="7.6" height="10.8" rx="1.4" fill="#fffdf6" transform="rotate(-8 10 10)"/><path d="M10 13.2c-.6-.6-2.3-1.6-2.3-2.8 0-.9 1.1-1.4 2.3-.4 1.2-1 2.3-.5 2.3.4 0 1.2-1.7 2.2-2.3 2.8Z" fill="#c41230"/></svg>',
  birds:'<svg class="sw" viewBox="0 0 20 20"><circle cx="10" cy="10" r="8.6" fill="#e0241c" stroke="#3b220e" stroke-width="1.6"/><path d="M3.2 12.6c2 2.6 4.3 3.7 6.8 3.7s4.8-1.1 6.8-3.7c-2.2.9-4.4 1.3-6.8 1.3s-4.6-.4-6.8-1.3Z" fill="#f3dcb4"/><circle cx="7.6" cy="9.4" r="1.7" fill="#fff"/><circle cx="12.4" cy="9.4" r="1.7" fill="#fff"/><circle cx="8" cy="9.6" r=".7"/><circle cx="12" cy="9.6" r=".7"/><path d="M5.4 7.2l4 1.6M14.6 7.2l-4 1.6" stroke="#1d1007" stroke-width="1.5" stroke-linecap="round"/><path d="M8.6 11l2.8-.2 2 1.3-2.4.9Z" fill="#ffb31f" stroke="#7a3d06" stroke-width=".5"/></svg>',
  space:'<svg class="sw" viewBox="0 0 20 20"><defs><radialGradient id="swSp" cx=".3" cy=".3" r=".9"><stop offset="0" stop-color="#7a4fd6"/><stop offset=".55" stop-color="#1c1a5e"/><stop offset="1" stop-color="#060818"/></radialGradient></defs><circle cx="10" cy="10" r="8.6" fill="url(#swSp)" stroke="#a493ff" stroke-width="1.2"/><path d="M3.4 14.6a8.6 8.6 0 0 0 13.2 0c-1.6-1.6-4-2.4-6.6-2.4s-5 .8-6.6 2.4Z" fill="#3fa0e8"/><path d="M3.4 14.6c1.6-1.6 4-2.4 6.6-2.4s5 .8 6.6 2.4" fill="none" stroke="#8ff0ff" stroke-width=".8"/><circle cx="13.6" cy="12.6" r="1.3" fill="#ffd27a"/><circle cx="6" cy="6.4" r=".7" fill="#fff"/><circle cx="12.4" cy="5" r=".5" fill="#fff"/></svg>'};
window.svcPicker=o=>{
  const b=document.querySelector(o.btn);if(!b)return null;
  const w=document.createElement('div');w.className='svt';b.replaceWith(w);w.appendChild(b);b.classList.add('svt-btn');
  b.setAttribute('aria-haspopup','menu');b.setAttribute('aria-expanded','false');
  const m=document.createElement('div');m.className='svt-menu';m.setAttribute('role','menu');m.hidden=true;w.appendChild(m);
  let cur=o.cur;
  const draw=()=>{const it=o.list.find(x=>x[0]===cur)||o.list[0],ic=it[3]||it[0];
    b.innerHTML=(IC[ic]||IC.auto)+'<span>'+it[1]+'</span>';b.title='Тема: '+it[1].toLowerCase();
    let g='';m.innerHTML=o.list.map(([k,n,grp,base])=>((grp||'')!==g?(g=grp||'','<div class="tgrp">'+g+'</div>'):'')+
      '<button type="button" role="menuitemradio" aria-checked="'+(k===cur)+'" data-svt="'+k+'">'+((o.sw&&o.sw[k])||SW[base||k]||SW.auto)+n+'</button>').join('')};
  const show=on=>{m.hidden=!on;b.setAttribute('aria-expanded',on?'true':'false')};
  b.addEventListener('click',e=>{e.preventDefault();e.stopPropagation();show(m.hidden)});
  m.addEventListener('click',e=>{const x=e.target.closest('[data-svt]');if(!x)return;e.stopPropagation();cur=x.dataset.svt;show(false);draw();o.onPick(cur)});
  document.addEventListener('pointerdown',e=>{if(!m.hidden&&!e.target.closest('.svt'))show(false)},true);
  document.addEventListener('keydown',e=>{if(e.key==='Escape'&&!m.hidden){show(false);b.focus()}});
  draw();
  return {set(k){cur=k;draw()},close(){show(false)}};
};
/* «назад» на телефоне не выкидывает с сайта (Андрей 29.10: «назад сначала закрывает всплывающее, потом в начало раздела, потом на главную,
   а на главной — наверх; с сайта не выкидывать, и так везде надо»). Над страницей — запас записей-«стражей» {svg:1…20}; каждое «назад»
   тратит одну и делает один шаг. Записи ставим только из касания (отпустил палец, клик, клавиша): добавленные без него Chrome кнопкой
   «назад» пропускает — поэтому не «поставить стража заново после назад», а запас, который доливается при следующем касании.
   svcBack({pop:[шаги страницы: вернуть true, если что-то закрыли], main: перейти в главный раздел (true, если перешли), home: «это главная»}) */
window.svcBack=o=>{
  const q=s=>document.querySelector(s),rs=history.replaceState.bind(history),ps=history.pushState.bind(history),N=20;
  const n=()=>{const s=history.state;return s&&s.svg||0};   // номер стража; 0 — не страж (основа страницы или своя запись страницы)
  let last=n(),gu=location.href;   // gu — адрес текущей записи: страницы меняют в нём раздел (#skleyki) — после «назад» оставляем его
  history.replaceState=function(s,t,u){const k=n();if(k&&!(s&&s.svg))s=Object.assign({},s,{svg:k});rs(s,t,u);if(n())gu=location.href};
  const fill=()=>{try{let k=n();const s=history.state;
    if(!k){if(s&&!s.svb&&Object.keys(s).length)return;rs(Object.assign({},s,{svb:1}),'')}   // своя запись страницы (карточка Юнитки) — не доливаем
    for(k++;k<=N;k++)ps({svg:k},'',location.href);last=n();gu=location.href}catch(e){}};
  ['click','touchend','keydown'].forEach(k=>document.addEventListener(k,fill,{capture:true,passive:true}));
  const step=()=>{
    for(const f of o.pop||[])if(f())return;                                   // всплывающее страницы: фишки, листы, окна
    if(m.classList.contains('on')){open(false);return}                       // выбор сервиса
    const t=q('.svt-btn[aria-expanded="true"]');if(t){t.click();return}       // выбор темы
    const big=q('#sxCard.big [data-sx="big"],#ptCard.big [data-pt="big"],#abCard.big [data-ab="big"],#spCard.big [data-sp="big"]');if(big){big.click();return}
    const g=q('#sxCard.flip [data-sx="back"],#ptCard.flip [data-pt="back"],#abCard.flip [data-ab="back"]');if(g){g.click();return}   // игра — обратно на баннер
    if(scrollY>40){scrollTo({top:0,behavior:'smooth'});return}              // в начало раздела
    if(o.main&&o.main())return;                                               // на главный раздел
    if(o.home)o.home();                                                       // уже на главной, наверху
  };
  addEventListener('popstate',()=>{const k=n(),s=history.state;
    // «назад» — номер стража стал меньше (с записи страницы на стража того же номера — это её собственный «назад», не наш);
    // основа страницы — запас кончился, шаг всё равно делаем
    if(k?k<last:!!(s&&s.svb)){const was=location.href;step();if(location.href===was)try{rs(history.state,'',gu)}catch(x){}}   // шаг не сменил раздел — адрес оставляем прежний
    last=k;gu=location.href});
};
})();
/*/SVC:JS*/</script>

