let FACT = null, FSEL = null, FQ = "", FSORT = LS.get("sumSort2", "sales"), SUMF = LS.get("sumMp", "all"), FADS = "pct", FPRICE = null, SHOWALL = false, SUMP = LS.get("sumPer", "month");
const b64u8 = s => {   // встроенный fromBase64, иначе простой цикл: Uint8Array.from с функцией на каждый знак в разы медленнее (28.10)
  if (Uint8Array.fromBase64) return Uint8Array.fromBase64(s);
  const b = atob(s), n = b.length, u = new Uint8Array(n); for (let i = 0; i < n; i++) u[i] = b.charCodeAt(i); return u;
};
async function deriveKey(pass, saltB64, iter) {
  const base = await crypto.subtle.importKey("raw", new TextEncoder().encode(pass), "PBKDF2", false, ["deriveKey"]);
  return crypto.subtle.deriveKey({ name: "PBKDF2", hash: "SHA-256", salt: b64u8(saltB64), iterations: iter }, base, { name: "AES-GCM", length: 256 }, true, ["decrypt"]);
}
async function loadFact(pass) {
  const res = await fetch("fact.enc.json?t=" + Date.now(), { cache: "no-store" });
  if (!res.ok) throw new Error(res.status === 404 ? "Данные ещё не выложены" : "Данные не загрузились (" + res.status + ")");
  const enc = await res.json();
  let key = null;
  const kc = LS.get("kc", null);
  if (!pass && kc && kc.salt === enc.salt) key = await crypto.subtle.importKey("raw", b64u8(kc.k), "AES-GCM", false, ["decrypt"]);
  if (!key) {
    pass = pass || LS.get("pass", "");
    if (!pass) throw new Error("NEED_PASS");
    key = await deriveKey(pass, enc.salt, enc.iter);
  }
  let plain;
  try { plain = await crypto.subtle.decrypt({ name: "AES-GCM", iv: b64u8(enc.iv) }, key, b64u8(enc.ct)); }
  catch (e) { LS.del("kc"); throw new Error("BAD_PASS"); }
  if (pass) {
    LS.set("pass", pass);
    try { const raw = new Uint8Array(await crypto.subtle.exportKey("raw", key)); let bin = ""; raw.forEach(x => bin += String.fromCharCode(x)); LS.set("kc", { salt: enc.salt, k: btoa(bin) }); } catch (e) {}
  }
  return JSON.parse(new TextDecoder().decode(plain));
}
