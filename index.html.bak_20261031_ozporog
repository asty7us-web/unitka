    { sel: "#name", t: "Найдите свой товар", d: "Начните печатать артикул — ниже появится список ваших товаров. Нажмите на товар, и подставятся цена сейчас и все расходы из панели. Можно и просто вписать своё название и считать с нуля." },
    { sel: "#mpSeg", t: "Площадка", d: "У каждой площадки свои комиссии и логистика. Переключайте — подставятся расходы этой площадки." },
    { sel: 'details[data-sec="price"] > summary', t: "Цена", d: "Цена до скидки и ваша скидка — или сразу цена продажи, поля связаны." },
    { sel: 'details[data-sec="cost"] > summary', t: "Себестоимость", d: "Закупка, доставка партии, ФФ и упаковка — итог внизу блока." },
    { sel: 'details[data-sec="mp"] > summary', t: "Расходы площадки", d: "Комиссия, логистика с учётом выкупа, хранение. «Запомнить по умолчанию» внизу — и новые расчёты начнутся с ваших цифр." },
    { sel: () => (isPhone() ? "#mini" : "#res .hero"), t: "Итог", d: "Прибыль с 1 шт, маржа и ROI. На телефоне эта полоска всегда внизу — нажмите, и откроется полный итог." },
    { sel: "#wiR", t: "Что если поменять цену", d: "Ползунок цены: прибыль, маржа и сколько штук продавать для той же прибыли." },
    { sel: "#bSave", t: "В мои расчёты", d: "Сохраняет расчёт во вкладку «Мои расчёты» на этом устройстве." },
    { sel: "#bShare", t: "Поделиться", d: "Ссылка, по которой этот расчёт откроется на другом телефоне или компьютере." }
  ],
  saved: [
    { sel: "#savedBox .toolbar", t: "Мои расчёты", d: "Здесь сохранённые расчёты этого устройства. «Скачать в Excel» — все расчёты одной таблицей." },
    { sel: "#savedBox .empty", t: "Пока пусто", d: "Посчитайте товар во вкладке «Расчёт» и нажмите «В мои расчёты» — он появится здесь." },
    { sel: "#savedBox [data-cmp]", t: "Сравнение", d: "Отметьте галочкой два расчёта и больше — сверху появится таблица сравнения." },
    { sel: "#savedBox [data-open], #savedBox tr[data-row]", t: "Открыть расчёт", d: "Открывает расчёт во вкладке «Расчёт» — правьте и сохраняйте заново." }
  ],
  spp: [
    { sel: "#sppTot", t: "СПП на ладони", d: "Средний СПП по площадкам и сколько товаров за неделю получили больше или меньше скидки площадки." },
    { sel: "#sppList .item", t: "Товар", d: "СПП сейчас, изменение за 2 недели и гистограмма по дням, как в дашборде «СПП» панели: сплошной столбик — по продажам, бледный — по витрине. Нажмите — карточка: гистограмма крупно и смена цены с ценой для покупателя и топами." },
    { sel: "#sppSort", t: "Порядок", d: "По выручке, по СПП или по изменению за 2 недели — сначала, где СПП сильнее упал." }
  ]
};
let TR = null;
function tourDetail() {
  if (!FACT) return;
  if (!curFact().x) { const it = $("#factList .item:not(.dim)"); if (it) it.click(); }
  else if (isPhone() && !$("#detailWrap").classList.contains("open")) { const it = $$("#factList .item").find(b => b.dataset.key === FSEL) || $("#factList .item:not(.dim)"); if (it) it.click(); }
  if (isPhone() && $("#detailWrap").classList.contains("open")) TR.opened = true;
}
function tourUndetail() { if (TR && TR.opened && $("#detailWrap").classList.contains("open")) { TR.opened = false; history.back(); } }
const tourVis = el => el && el.getClientRects().length > 0 && !el.closest(".hidden");
function tourSeq(start) {             /* все шаги подряд: сначала открытая вкладка, потом остальные по кругу */
  const i0 = Math.max(0, TABORD.indexOf(start)), order = TABORD.slice(i0).concat(TABORD.slice(0, i0));
  return order.flatMap(tab => TOUR[tab].map(s => Object.assign({ tab }, s)));
}
function tourStart(tab) {
  tourEnd(true);
  TR = { seq: tourSeq(tab || TAB), i: -1 };
  const dim = document.createElement("div"); dim.className = "tour-dim";
  const spot = document.createElement("div"); spot.className = "tour-spot";
  const tip = document.createElement("div"); tip.className = "tour-tip"; tip.setAttribute("role", "dialog"); tip.setAttribute("aria-live", "polite");
  document.body.append(dim, spot, tip);
  TR.nodes = { dim, spot, tip };
  tip.addEventListener("click", e => {
    const b = e.target.closest("button"); if (!b || !TR) return;
    const a = b.dataset.tour || (b.classList.contains("tour-x") ? "end" : "");
    if (a === "next") tourGo(TR.i + 1, 1);
    if (a === "prev") tourGo(TR.i - 1, -1);
    if (a === "end") tourEnd();
  });
  tourGo(0, 1);
}
function tourGo(i, dir) {
  if (!TR) return;
  const seq = TR.seq;
  while (i >= 0 && i < seq.length) {
    const s = seq[i];
    if (s.tab !== TAB) {                  // шаг на другой вкладке — переключаем её и ждём отрисовки
      tourUndetail(); setTab(s.tab); window.scrollTo(0, 0);
      setTimeout(() => tourGo(i, dir), 180); return;
    }
    if (s.pre) s.pre();
    const sel = typeof s.sel === "function" ? s.sel() : s.sel, el = $$(sel).find(tourVis);
    if (el) { TR.i = i; TR.el = el; tourShow(s); return; }
    i += dir;
  }
  if (i < 0) return tourGo(0, 1);
  tourFinish();
}
function tourShow(s) {
  const n = TR.seq.length, i = TR.i, { tip } = TR.nodes;
  const last = !TR.seq.slice(i + 1).length;
  tip.innerHTML = `<button class="tour-x" aria-label="Закрыть подсказки">✕</button>
    <div class="tn">Фишки · ${TABN[s.tab]} · ${i + 1} из ${n}</div><h4>${esc(s.t)}</h4><p>${esc(s.d)}</p>
    <div class="tbar"><i style="width:${((i + 1) / n * 100).toFixed(1)}%"></i></div>
    <div class="tf"><span style="margin-right:auto"></span>${i > 0 ? '<button class="btn sm" data-tour="prev">Назад</button>' : ""}<button class="btn sm pri" data-tour="next">${last ? "Готово" : "Далее"}</button></div>`;
  tourMark((i + 1) / n);
  const fixed = getComputedStyle(TR.el).position === "fixed" || TR.el.closest("header,nav.tabs");
  if (!fixed) TR.el.scrollIntoView({ block: "center", inline: "nearest" });
  tourPlace(); setTimeout(tourPlace, 120); setTimeout(tourPlace, 400);
  const b = tip.querySelector('[data-tour="next"]'); if (b) b.focus({ preventScroll: true });
}
function tourFinish() {
  tourMark(1); tourUndetail(); tourEnd(true);
  toast("Все фишки пройдены. Подсказки всегда можно открыть снова кнопкой «Фишки».");
}
function tourMark(p) { if (p > LS.get("tourMax", 0)) { LS.set("tourMax", p); tourPaint(); } }
function tourPlace() {
  if (!TR || !TR.nodes) return;
  const { spot, tip } = TR.nodes, vw = innerWidth, vh = innerHeight, w = tip.offsetWidth, h = tip.offsetHeight;
  const navH = isPhone() ? 62 : 0, hdr = $("header").offsetHeight;
  if (!TR.el) { tip.style.left = Math.round((vw - w) / 2) + "px"; tip.style.top = Math.round(Math.max(hdr + 12, (vh - h) / 2)) + "px"; return; }
  const r = TR.el.getBoundingClientRect(), p = 6;
  const top = Math.max(0, r.top - p), left = Math.max(4, r.left - p), bottom = Math.min(vh, r.bottom + p), right = Math.min(vw - 4, r.right + p);
  spot.style.cssText = `top:${top}px;left:${left}px;width:${right - left}px;height:${bottom - top}px`;
  let ty = bottom + 12;
  if (ty + h > vh - navH - 8) { ty = top - 12 - h; if (ty < 8) ty = Math.max(hdr + 8, vh - navH - h - 12); }
  tip.style.top = Math.round(ty) + "px";
  tip.style.left = Math.round(Math.min(Math.max(12, (left + right) / 2 - w / 2), vw - w - 12)) + "px";
}
function tourEnd(silent) {
  if (!TR) return;
  if (TR.nodes) Object.values(TR.nodes).forEach(n => n.remove());
  if (!silent) tourUndetail();
  TR = null;
}
$("#bTour").onclick = () => tourStart(TAB);
addEventListener("resize", () => TR && tourPlace());
addEventListener("scroll", () => TR && tourPlace(), true);
addEventListener("keydown", e => {
  if (!TR || !TR.nodes) return;
  if (e.key === "Escape") tourEnd();
  else if (e.key === "ArrowRight" && TR.el) tourGo(TR.i + 1, 1);
  else if (e.key === "ArrowLeft" && TR.el) tourGo(TR.i - 1, -1);
});
/* кнопка «Фишки»: цвет занимает долю ещё не пройденных шагов и уходит справа налево */
function tourPaint() {
  const done = Math.min(1, LS.get("tourMax", LS.get("tourTabs", []).length >= 3 ? 1 : 0)), left = 1 - done, b = $("#bTour");
  b.style.setProperty("--tg", left.toFixed(3));
  b.classList.toggle("fresh", left > 0.001); b.classList.toggle("full", left >= 0.5);
  b.title = left > 0.001 ? `Подсказки пройдены на ${Math.round(done * 100)}% — цвет уходит по мере прохождения` : "Пошаговые подсказки";
}
tourPaint();

/* ═════════ старт ═════════ */
function setHdr() { document.documentElement.style.setProperty("--hdr", $("header").offsetHeight + "px"); }
(function init() {
  setHdr(); window.addEventListener("resize", setHdr);
  applyTheme();
  const h = new URLSearchParams(location.hash.slice(1));
  if (h.get("k")) { LS.set("pass", h.get("k")); LS.del("kc"); TAB = "sum"; }
  if (h.get("c")) { try { S = fixState(decodeState(h.get("c"))); delete S.id; saveDraft(); TAB = "calc"; } catch (e) { toast("Ссылка на расчёт повреждена"); } }
  if (h.get("z")) { TAB = "calc"; unpackZ(h.get("z")).then(st => { S = fixState(st); delete S.id; saveDraft(); writeForm(); render(); }).catch(() => toast("Ссылка на расчёт повреждена")); }
  takeView();                                                           // после «потянуть — обновить» — туда же, где был
  if (h.get("spp")) { SPPHASH = h.get("spp"); TAB = "spp"; }           // из «Конкурентов»: #spp=ozon:<артикул> — СПП этого товара
  if (h.get("k") || h.get("c") || h.get("z") || h.get("spp")) history.replaceState(null, "", location.pathname + location.search);
  if (isPhone()) $$("details.sec").forEach(d => { if (!["price", "cost", "mp"].includes(d.dataset.sec)) d.open = false; });
  writeForm(); render(); setTab(["sum", "calc", "spp", "saved"].includes(TAB) ? TAB : "sum");
  if (location.hash === "#ext") extOpen();
})();
/* приложение на телефон: service worker (sw.js) — без него Chrome не предлагает «Установить»; своя кнопка «Установить» в шапке */
if ("serviceWorker" in navigator) addEventListener("load", () => navigator.serviceWorker.register("sw.js").catch(() => {}));
let INSTALL = null;
addEventListener("beforeinstallprompt", e => { e.preventDefault(); INSTALL = e; $("#bInstall").classList.remove("hidden"); });
addEventListener("appinstalled", () => { INSTALL = null; $("#bInstall").classList.add("hidden"); toast("Юнитка установлена — значок на экране телефона"); });
$("#bInstall").onclick = async () => {
  if (!INSTALL) return;
  INSTALL.prompt(); try { await INSTALL.userChoice; } catch (e) {}
  INSTALL = null; $("#bInstall").classList.add("hidden");
};
</script>
