/* одна строка панели → рубли на 1 проданную шт. row.h — те же статьи за несколько месяцев, когда в месяце продано меньше 3 шт (baza.py):
   src — за какие месяцы, ub — штук в них, units — в среднем за месяц с продажами */
function unit(row) {
  const b = row.h || row, u = num(b.units), sales = num(b.sales);
  if (u <= 0 || sales <= 0) return null;
  const per = k => num(b[k]) / u;
  const x = { price: sales / u, comm: per("comm"), acq: per("acq"), logi: per("logi"), stor: per("stor"), ff: per("ff"), dop: per("dop"),
              loyal: per("loyal"), ads: per("ads") + per("ads2"), tax: per("tax"), cost: per("cost"), profit: per("profit"),
              units: row.h ? u / (num(row.h.n) || 1) : u, ub: u, src: row.h ? row.h.label : "" };
  const sum = x.comm + x.acq + x.logi + x.stor + x.ff + x.dop + x.loyal + x.ads + x.tax + x.cost;
  x.resid = x.price - sum - x.profit;      // если панель считает иначе — «прочее», чтобы факт совпал с панелью
  // в панели ФФ нет (у ЯМ — никогда): ставка из таблицы «Услуги Фулфилмента» (ffs), доукомплектовка ЯМ — из панелей ВБ/Озон (dops); прибыль юнитки меньше на них
  if (!(x.ff > 0.004) && num(row.ffs) > 0) { x.ff = num(row.ffs); x.profit -= x.ff; x.ffTab = true; }
  if (!(x.dop > 0.004) && num(row.dops) > 0) { x.dop = num(row.dops); x.profit -= x.dop; x.dopTab = true; }
  x.cR = x.comm / x.price; x.aR = x.acq / x.price; x.tR = x.tax / x.price; x.drr = x.ads / x.price;
  return x;
}
function at(x, p, adsMode) {
  const comm = x.cR * p, acq = x.aR * p, tax = x.tR * p, ads = adsMode === "pct" ? x.drr * p : x.ads;
  const fixed = x.logi + x.stor + x.ff + x.dop + x.loyal + x.resid + x.cost;
  const profit = p - comm - acq - tax - ads - fixed;
  return { p, comm, acq, tax, ads, profit, margin: profit / p, roi: x.cost > 0 ? profit / x.cost : NaN };
}
function factPrice(x, adsMode, m) {           // цена, при которой маржа = m
  const rate = x.cR + x.aR + x.tR + (adsMode === "pct" ? x.drr : 0);
  const fixed = x.logi + x.stor + x.ff + x.dop + x.loyal + x.resid + x.cost + (adsMode === "pct" ? 0 : x.ads);
  return 1 - rate - m > 0 ? fixed / (1 - rate - m) : null;
}
const norm = s => String(s || "").toLowerCase().replace(/ё/g, "е");
const mpIco = (mp, big) => `<span class="mpi ${mp}${big ? " big" : ""}" title="${MPS[mp].name}"></span>`;
const mpTag = mp => `<span class="badge">${MPS[mp].short}</span>`;
/* WB — кабинеты по-нашему: ИП Топал = Каб 1, ИП Мамаева = Каб 2; у Ozon и ЯМ кабинет один — не пишем */
const cab = (mp, ip) => (mp !== "wb" || !ip ? "" : /топал/i.test(ip) ? "Каб 1" : /мамаев/i.test(ip) ? "Каб 2" : ip);
/* подпись под товаром: продажи за месяц панели и, если добраны прошлые месяцы, за какие считается юнитка */
const soldTxt = (r, x) => !x ? "нет продаж" : (num(r.units) > 0 ? NF0.format(num(r.units)) + " шт за месяц" : "нет продаж в месяце") + (x.src ? " · юнитка за " + x.src : "");
const PER = { week: "за неделю", w2: "за 2 недели", month: "за месяц" };
/* строка панели за выбранный срок (месяц — сама строка; неделя / 2 недели — из per) */
function perOf(mp) { const p = FACT && FACT.mp[mp]; return SUMP === "month" ? p && { label: p.month, rows: p.rows } : p && p.per && p.per[SUMP]; }
function perRow(mp, r) {
  if (SUMP === "month") return r;
  const pr = perOf(mp); if (!pr) return undefined;          // у площадки нет такого среза
  return pr.rows.find(z => z.a === r.a && (z.ip || "") === (r.ip || "")) || null;   // null — в этот срок продаж не было
}
function panelM(pr) {
  if (!pr || !(num(pr.sales) > 0)) return { m: null, nd: null, drr: null };
  const s = num(pr.sales), nd = pr.nodrr != null ? num(pr.nodrr) : num(pr.profit) + num(pr.ads) + num(pr.ads2);
  const ads = num(pr.ads) + num(pr.ads2) || Math.max(0, nd - num(pr.profit));
  return { m: num(pr.profit) / s, nd: nd / s, drr: ads / s, ads };
}
/* прогноз «по панели» при новой цене (Андрей 26.10: «как будто панель показала бы, если цену поменять, но комиссия и прочее — фактические панели»):
   те же продажи в штуках, выручка × k (k = новая ÷ сейчас); комиссия, эквайринг, налог — × k (те же % панели); реклама — × k при «ДРР в %», иначе те же рубли;
   логистика, хранение, ФФ, себестоимость и прочее — те же рубли панели за срок */
function panelAt(pr, k) {
  const pm = panelM(pr);
  if (pm.m == null || !(k > 0)) return pm;
  const s = num(pr.sales), v = num(pr.comm) + num(pr.acq) + num(pr.tax), dA = FADS === "pct" ? pm.ads * (k - 1) : 0;
  const s2 = s * k, d = (s2 - s) - v * (k - 1);
