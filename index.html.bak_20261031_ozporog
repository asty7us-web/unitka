  [data-theme="space"] header{background:rgba(7,9,26,.66);backdrop-filter:blur(14px);-webkit-backdrop-filter:blur(14px)}
}
[data-theme="space"] :is(.card,details.sec,.search,.sumtot){backdrop-filter:blur(14px);-webkit-backdrop-filter:blur(14px);border-color:rgba(200,190,255,.12)}
