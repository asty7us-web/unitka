  --good:#2b8a14; --good-bg:#dff4cc; --bad:#d8261b; --bad-bg:#ffd9d4; --warn-bg:#fff1bf; --mid:#a86400;
  --s1:#7ad321; --s2:#e0331f; --s3:#3a9df0; --s4:#ffc21a; --s5:#f48fb1; --s6:#2b8a14;
  --shadow:5px 5px 0 #1a1022; --r:16px;
