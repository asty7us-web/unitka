}
/* плитка «маржа по панели»: при цене сейчас — факт, при другой — прогноз и рядом факт */
function panelKpi(pr, k, t, lbl) {
  const moved = Math.abs(k - 1) >= 0.0005, q = panelAt(pr, k), f = panelM(pr);
  if (q.m == null) return `<div class="kpi"><b>—</b><span>${lbl} — продаж не было</span></div>`;
  return `<div class="kpi"><b class="${tone(q.m, t)}">${pct(q.m)}</b><span>${lbl}${moved ? " — прогноз" : ""}<br>без ДРР ${pct(q.nd)} · ДРР ${pct(q.drr)}${moved ? `<br>факт ${pct(f.m)} · <span class="${cls(q.m - f.m)}">${ppTxt(q.m - f.m)} п.п.</span>` : ""}</span></div>`;
}
function sumItems() {
  const words = qWords(FQ), out = [];
  for (const mp of ["wb", "ozon", "ym"]) {
    if (SUMF !== "all" && SUMF !== mp) continue;
    const p = FACT && FACT.mp[mp]; if (!p) continue;
    for (const r of p.rows) {
      if (words.length && !hitRow(words, r)) continue;
      const x = unit(r), now = num(r.now) || null, n = x && now ? at(x, now, FADS) : null, pr = perRow(mp, r);
      out.push({ mp, r, x, now, n, pr, pm: panelM(pr), key: mp + "|" + (r.ip || "") + "|" + r.a });
    }
  }
  const low = v => (v == null ? Infinity : v), high = v => (v == null ? -Infinity : v);
  out.sort((a, b) => {
    if (!a.x !== !b.x) return a.x ? -1 : 1;
    if (FSORT === "name") return a.r.a.localeCompare(b.r.a, "ru");
    if (FSORT === "unit") return low(a.n && a.n.margin) - low(b.n && b.n.margin);
    if (FSORT === "panel") return low(a.pm.m) - low(b.pm.m);
    if (FSORT === "drr") return high(b.pm.drr) - high(a.pm.drr);
    return num(b.r.sales) - num(a.r.sales);       // всегда за месяц: смена срока не двигает строки, меняются только «По панели» и ДРР
  });
  return out;
}
function perLabel(mp) { const pr = perOf(mp); return pr ? String(pr.label).toLowerCase().replace(/\s*[-–]\s*/g, " – ").replace(/\./g, " ").replace(/\s+/g, " ").replace(/ –/g, " –").trim() : null; }
