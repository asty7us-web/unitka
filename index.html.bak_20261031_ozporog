/* ═════════ «потянуть вниз — обновить» (Андрей 26.10: в приложении тянется не во всех разделах): в приложении — везде, в браузере — в открытых
   карточках (там своя прокрутка, браузер не тянет). Не срабатывает с ползунков, полей и игр. ═════════ */
(function () {
  const pwa = () => matchMedia("(display-mode: standalone)").matches || navigator.standalone === true;
  const ind = document.createElement("div"); ind.id = "ptr"; ind.setAttribute("aria-hidden", "true"); ind.textContent = "↻"; document.body.appendChild(ind);
  let y0 = null, dy = 0, el = null;
