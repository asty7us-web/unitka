[data-theme="space"] .brand i{background:radial-gradient(circle at 35% 30%,#fff 0,#cfc6ff 18%,#7a64ff 55%,#2c1f80 100%);color:#fff;border-radius:50%;box-shadow:0 0 14px rgba(164,147,255,.6)}
[data-theme="space"] .brand span{font-family:var(--font-h);font-weight:700;letter-spacing:.04em}
[data-theme="space"] :is(.btn.pri,.chip.on){background:linear-gradient(135deg,#c2b6ff,#806cff);color:#0b0a26;border-color:transparent}
[data-theme="space"] .seg button[aria-pressed="true"]{background:rgba(164,147,255,.24);box-shadow:none}
[data-theme="space"] :is(.btn,.inp,select.sel,.kpi){border-radius:14px}
[data-theme="space"] main{position:relative;padding-top:24px}
/* окошко-баннер: картинка (.spimg) плывёт камерой, сверху живые звёзды (canvas), рамка-«прицел» по углам как в играх */
#spCard{position:relative;height:var(--sbh);margin:0 0 26px;border-radius:22px;overflow:hidden;isolation:isolate;background:#050716;outline:none;
  box-shadow:0 0 0 1px rgba(190,180,255,.3),0 0 42px rgba(120,100,255,.24),0 18px 50px rgba(0,0,0,.55);-webkit-user-select:none;user-select:none}
#spCard:focus-visible{box-shadow:0 0 0 2px #cfc6ff,0 0 42px rgba(120,100,255,.4)}
#spCard .spimg{position:absolute;inset:-7%;background:var(--sph) 50% 50%/cover;transition:transform 2.6s cubic-bezier(.2,.7,.2,1);will-change:transform}
#spCard .spsh{position:absolute;inset:0;background:radial-gradient(ellipse 62% 60% at 50% 48%,rgba(4,6,20,.58),rgba(4,6,20,.18) 72%,transparent),
  linear-gradient(180deg,rgba(4,6,20,.6),transparent 26%,transparent 72%,rgba(4,6,20,.6))}
#spCard canvas.spst{position:absolute;inset:0;width:100%;height:100%;pointer-events:none}
#spCard .spfl{position:absolute;inset:0;z-index:1;pointer-events:none;opacity:0;
  background:linear-gradient(105deg,transparent 30%,rgba(220,214,255,.16) 45%,rgba(255,255,255,.28) 50%,rgba(220,214,255,.16) 55%,transparent 70%)}
#spCard .sphud{position:absolute;z-index:2;inset:10px;pointer-events:none;border-radius:16px;border:1px solid rgba(200,190,255,.16)}
#spCard .sphud i{position:absolute;width:24px;height:24px;border:2px solid #d3cbff;filter:drop-shadow(0 0 5px rgba(164,147,255,.95))}
#spCard .sphud i:nth-child(1){left:-1px;top:-1px;border-right:0;border-bottom:0;border-top-left-radius:16px}
#spCard .sphud i:nth-child(2){right:-1px;top:-1px;border-left:0;border-bottom:0;border-top-right-radius:16px}
#spCard .sphud i:nth-child(3){left:-1px;bottom:-1px;border-right:0;border-top:0;border-bottom-left-radius:16px}
#spCard .sphud i:nth-child(4){right:-1px;bottom:-1px;border-left:0;border-top:0;border-bottom-right-radius:16px}
#spCard .sptop{position:absolute;z-index:3;left:26px;right:26px;top:22px;display:flex;align-items:center;gap:10px;pointer-events:none;
  font:700 11px/1 var(--font);letter-spacing:.16em;text-transform:uppercase;color:rgba(232,229,255,.85)}
#spCard .splogo{font:700 13px/1 var(--font-h);letter-spacing:.26em;color:#fff;text-shadow:0 0 12px rgba(164,147,255,.95)}
#spCard .spch{padding:5px 10px;border-radius:999px;background:rgba(164,147,255,.16);border:1px solid rgba(200,190,255,.32)}
#spCard .spnum{margin-left:auto;font-variant-numeric:tabular-nums}
#spCard .spstage{position:absolute;z-index:2;inset:58px 78px 56px;display:grid;place-items:center;text-align:center;cursor:grab;touch-action:pan-y}
#spCard .spstage:active{cursor:grabbing}
#spCard .spq{grid-area:1/1;margin:0;max-width:21ch;font:800 clamp(25px,3.5vw,50px)/1.16 var(--font);letter-spacing:-.022em;color:#fff;text-wrap:balance;
  text-shadow:0 2px 22px rgba(5,6,25,.85),0 0 40px rgba(130,110,255,.35)}
#spCard .spq span{display:inline-block}
#spCard .spq.drag{transition:none}
#spCard .spq.back{transition:transform .35s cubic-bezier(.2,.8,.2,1),opacity .35s}
#spCard .spnav{position:absolute;z-index:3;top:50%;width:46px;height:46px;margin-top:-23px;padding:0;border-radius:50%;border:1px solid rgba(220,215,255,.36);
  background:rgba(10,12,36,.42);color:#fff;display:grid;place-items:center;cursor:pointer;-webkit-backdrop-filter:blur(6px);backdrop-filter:blur(6px);transition:transform .2s,background .2s}
#spCard .spnav:hover{background:rgba(164,147,255,.38);transform:scale(1.08)}
#spCard .spnav:active{transform:scale(.94)}
#spCard .spnav.prev{left:20px} #spCard .spnav.next{right:20px}
#spCard .spnav svg,#spCard .spbtns svg{width:20px;height:20px;display:block}
#spCard .spbar{position:absolute;z-index:3;left:26px;right:146px;bottom:20px;display:flex;gap:6px}
#spCard .spbar button{flex:1;min-width:0;height:16px;padding:6px 0;border:0;background:none;cursor:pointer}
#spCard .spbar button i{display:block;height:4px;border-radius:2px;background:rgba(255,255,255,.22);overflow:hidden}
#spCard .spbar button i b{display:block;height:100%;width:100%;background:#fff;transform:scaleX(0);transform-origin:0 50%}
#spCard .spbar button.done i b{transform:scaleX(1);background:rgba(255,255,255,.75)}
#spCard .spbar button.cur i b{animation:sp-fill 7s linear forwards;box-shadow:0 0 8px #b3a5ff}
#spCard:is(.hold,.stop) .spbar button.cur i b{animation-play-state:paused}
@keyframes sp-fill{to{transform:scaleX(1)}}
#spCard .spbtns{position:absolute;z-index:3;right:22px;bottom:10px;display:flex;gap:6px}
#spCard .spbtns button{width:36px;height:36px;border-radius:50%;border:1px solid rgba(220,215,255,.36);background:rgba(10,12,36,.42);color:#fff;display:grid;place-items:center;padding:0;cursor:pointer}
#spCard .spmenu{position:absolute;right:0;bottom:44px;display:flex;flex-direction:column;gap:4px;padding:6px;border-radius:16px;background:rgba(10,12,36,.86);border:1px solid rgba(220,215,255,.36)}
#spCard .spmenu[hidden]{display:none}
#spCard .spbtns .spmenu button{width:auto;height:34px;border-radius:17px;padding:0 16px;font-size:14px;font-family:inherit;white-space:nowrap;display:block;text-align:left}
#spCard .spbtns .spmenu button[aria-current="true"]{background:rgba(164,147,255,.6);border-color:#fff}
#spCard [data-sp="next"] small{font-size:10px;margin:6px 0 0 1px}
#spCard .spbtns [data-sp="next"]{display:flex;align-items:center;justify-content:center}
#spCard .spbtns button:hover{background:rgba(164,147,255,.38)}
#spCard .spbtns svg{width:16px;height:16px}
#spCard [data-sp="play"] .pl,#spCard.stop [data-sp="play"] .pa,#spCard [data-sp="mute"] .off,#spCard [data-sp="mute"][aria-pressed="true"] .on{display:none}
#spCard [data-sp="mute"][aria-pressed="true"] .off{display:block}
#spCard.stop [data-sp="play"] .pl{display:block}
#spCard.big{position:fixed;inset:0;z-index:300;height:auto;margin:0;border-radius:0}
#spCard.big .spq{font-size:clamp(30px,5.2vw,80px)}
#spCard.big .spstage{inset:84px 96px 84px}
@media (max-width: 860px){
  :root[data-theme="space"]{--spbg:url("space-bg-m.webp");--sph:url("space-hero-m.webp");--sbh:max(300px,82vw)}
  [data-theme="space"] nav.tabs{background:rgba(7,9,26,.9);backdrop-filter:blur(14px);-webkit-backdrop-filter:blur(14px);border-top-color:rgba(164,147,255,.2)}
  [data-theme="space"] nav.tabs button[aria-current="page"]{color:#cfc6ff}
  [data-theme="space"] .detail-wrap.open .backbar{background:var(--solid)}
  [data-theme="space"] main{padding-top:16px}
  #spCard{margin:0 0 22px;border-radius:18px}
  #spCard .sptop{left:20px;right:20px;top:20px;font-size:10px;letter-spacing:.12em}
  #spCard .splogo{font-size:11.5px}
  #spCard .spstage{inset:52px 20px 56px}
  #spCard .spq{max-width:none;font-size:clamp(21px,6.3vw,30px)}
  #spCard .spnav{display:none}                                     /* на телефоне — свайп или тап по краю */
  #spCard .spbar{left:20px;right:150px;bottom:18px;gap:4px}
  #spCard .spbtns{right:16px;bottom:9px}
